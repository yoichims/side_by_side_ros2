Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /Subgoals1
      Splitter Ratio: 0.5
    Tree Height: 700
  - Class: rviz_common/Tool Properties
    Name: Tool Properties
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
    Frame Rate: 30
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 1
      Plane Cell Count: 40
      Color: 160; 160; 164
      Alpha: 0.3
    - Class: rviz_default_plugins/Map
      Name: Map
      Enabled: true
      Topic:
        Value: /map
        Depth: 1
        Durability Policy: Transient Local
        Reliability Policy: Reliable
      Color Scheme: map
      Alpha: 0.7
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: false
      Marker Scale: 1
      Show Names: true
    # --- the global path lambda, placed with 2D Nav Goal ---
    - Class: rviz_default_plugins/Marker
      Name: Subgoals
      Enabled: true
      Topic:
        Value: /subgoalVisualization
        Depth: 5
        Durability Policy: Transient Local
        Reliability Policy: Reliable
    # --- vehicle 1 ---
    - Class: rviz_default_plugins/LaserScan
      Name: v1 scan
      Enabled: true
      Topic:
        Value: /v1/scan
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Best Effort
      Size (m): 0.03
      Style: Points
      Color: 0; 255; 255
      Color Transformer: FlatColor
    - Class: rviz_default_plugins/Marker
      Name: v1 candidate trajectories
      Enabled: true
      Topic:
        Value: /v1/trajectory_mark_filter2
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/Marker
      Name: v1 optimal trajectory
      Enabled: true
      Topic:
        Value: /v1/trajectory_mark_optimal
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/Map
      Name: v1 obstacle grid
      Enabled: false
      Topic:
        Value: /v1/occMapViz
        Depth: 1
        Durability Policy: Volatile
        Reliability Policy: Reliable
      Color Scheme: costmap
      Alpha: 0.6
    # --- vehicle 2 ---
    - Class: rviz_default_plugins/LaserScan
      Name: v2 scan
      Enabled: true
      Topic:
        Value: /v2/scan
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Best Effort
      Size (m): 0.03
      Style: Points
      Color: 255; 170; 0
      Color Transformer: FlatColor
    - Class: rviz_default_plugins/Marker
      Name: v2 candidate trajectories
      Enabled: true
      Topic:
        Value: /v2/trajectory_mark_filter2
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/Marker
      Name: v2 optimal trajectory
      Enabled: true
      Topic:
        Value: /v2/trajectory_mark_optimal
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/Map
      Name: v2 obstacle grid
      Enabled: false
      Topic:
        Value: /v2/occMapViz
        Depth: 1
        Durability Policy: Volatile
        Reliability Policy: Reliable
      Color Scheme: costmap
      Alpha: 0.6
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
      Line color: 128; 128; 0
    # Subgoals are placed with this tool. subgoal.cpp listens on
    # /move_base_simple/goal, not RViz 2's default /goal_pose.
    - Class: rviz_default_plugins/SetGoal
      Topic:
        Value: /move_base_simple/goal
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: Current View
      Target Frame: map
      X: 22
      Y: 6
      Scale: 25
      Angle: 0
Window Geometry:
  Height: 1000
  Width: 1600
  Displays:
    collapsed: false
