<?xml version="1.0" encoding="UTF-8"?>
<!--
  Fast DDS transport profile for the map.

  The 7th-floor map is 4000x4000 cells at 0.05 m, so a single nav_msgs/OccupancyGrid
  is ~16 MB. ROS 2's default UDP socket buffer is net.core.rmem_default (213 KB
  on a stock Ubuntu), where a sample that large arrives as many fragments and
  losing any one of them discards the whole map. The symptom is a map server
  that publishes and subscribers that never receive, with no error anywhere.

  Only UDP is declared, deliberately: Docker gives a container 64 MB of /dev/shm
  by default and every participant allocates its own segment, so a shared-memory
  transport exhausts it once a few nodes plus the ros2 CLI daemon are running.
  Enlarged UDP buffers cost nothing on loopback.

  The kernel clamps the socket buffer to net.core.rmem_max; 4 MB is the stock
  Ubuntu ceiling, so this request is honoured as written.

  Set automatically by the launch files. For a node started by hand, or an RViz
  in another terminal, it has to be exported there too:
    export FASTRTPS_DEFAULT_PROFILES_FILE=<this file>
-->
<dds xmlns="http://www.eprosima.com/">
  <profiles>
    <transport_descriptors>
      <transport_descriptor>
        <transport_id>large_udp</transport_id>
        <type>UDPv4</type>
        <sendBufferSize>4194304</sendBufferSize>
        <receiveBufferSize>4194304</receiveBufferSize>
      </transport_descriptor>
    </transport_descriptors>

    <participant profile_name="sbs_large_messages" is_default_profile="true">
      <rtps>
        <userTransports>
          <transport_id>large_udp</transport_id>
        </userTransports>
        <useBuiltinTransports>false</useBuiltinTransports>
      </rtps>
    </participant>
  </profiles>
</dds>
